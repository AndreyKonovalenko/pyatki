{
  "name": "pyatki",
  "version": "1.0.0",
  "description": "",
  "main": "main.ts",
  "bin": "src/main.ts",
  "pkg": {
    "scripts": [
      "src/**/*.ts"
    ],
    "assets": [
      "storage/cookies/*.json"
    ]
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "balance": "tsx src/main.ts --method=check_balance",
    "build": "tsc",
    "card": "tsx src/main.ts --method=get_company_card",
    "courts": "tsx src/main.ts --method=get_company_court_cases",
    "owners": "tsx src/main.ts --method=get_company_owners",
    "fin_report": "tsx src/main.ts --method=get_company_financial_report --year=2025",
    "ip_card": "tsx src/main.ts --method=get_entrepreneur_card",
    "format-fix": "prettier . --write"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "0.27.2",
    "axios-cookiejar-support": "7.0.0",
    "dotenv": "^17.4.2",
    "tough-cookie": "5.0.0",
    "tough-cookie-file-store": "^3.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "tough-cookie": "5.0.0"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6"
  }
}
